# ---------------------------------------------------------------------------
# Portal REMS — salin ke Environment Variables project Vercel "portal"
# ---------------------------------------------------------------------------

# Upstash Redis untuk data user pusat + sesi login.
# Boleh memakai database Upstash yang sudah ada (semua kunci portal diawali
# "portal:" sehingga tidak bentrok dengan DMS/TTE).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kunci rahasia untuk menandatangani tiket login (JWT). Minimal 32 karakter
# acak. Nilai yang SAMA nanti dipasang juga di EMV, EMNV, SPA, DMS, TTE.
# Kalau diganti, semua orang otomatis keluar dan semua app harus ikut diganti.
SSO_SECRET=

# Domain cookie supaya login terbaca di semua subdomain.
# Produksi: .myrama.id   |   Lokal (localhost): kosongkan
COOKIE_DOMAIN=.myrama.id

# Domain yang boleh dijadikan tujuan setelah login (?next=...)
ALLOWED_REDIRECT_DOMAIN=myrama.id

# Lama sesi: batas keras sejak login (jam) dan batas diam (menit)
SESSION_HOURS=12
SESSION_IDLE_MINUTES=60

# Kode sekali pakai untuk membuat admin pertama di halaman /setup.
# Setelah admin pertama dibuat, halaman /setup terkunci permanen.
SETUP_KEY=
